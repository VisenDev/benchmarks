(defstruct tape
  (arr (make-array 30000 :initial-element 0 :element-type '(unsigned-byte 8))
   :type (array (unsigned-byte 8) (30000)))
  (ptr 0 :type fixnum)
  stdin
  stdout
  )

(defmacro wrapping-incf (form amount modulus)
  `(setf ,form (mod (+ ,form ,amount) ,modulus)))
(defmacro wrapping-decf (form amount modulus)
  `(setf ,form (mod (- ,form ,amount) ,modulus)))

(defmacro tape-value (tape)
  `(aref (tape-arr ,tape) (tape-ptr ,tape)))
(defun tape-increment (tape)
  (wrapping-incf (tape-value tape) 1 256))
(defun tape-decrement (tape)
  (wrapping-decf (tape-value tape) 1 256))
(defun tape-forward (tape)
  (incf (tape-ptr tape)))
(defun tape-backward (tape)
  (decf (tape-ptr tape)))
(defun tape-output (tape)
  (format (tape-stdout tape) "~a" (code-char (tape-value tape))))
(defun tape-input (tape)
  (setf (tape-value tape) (mod (char-code (read-char (tape-stdin tape))) 256)))

(defstruct interpreter
  tape
  program
  code-ptr
  return-stack
  )

(defun interpreter-char (interpreter)
  (char (interpreter-program interpreter) (interpreter-code-ptr interpreter)))

(defun interpreter-forward (interpreter)
  (incf (interpreter-code-ptr interpreter)))

(defun interpreter-begin-block (interpreter)
  (let* ((tape (interpreter-tape interpreter))
         )
    (if (= 0 (tape-value tape))
      (loop :with unmatched-count = 0
            :while (> unmatched-count 0)
            :when (char= (interpreter-char interpreter) #\[)
              :do (incf unmatched-count)
            :end
            :when (char= (interpreter-char interpreter) #\])
              :do (decf unmatched-count)
            :end
            :do (interpreter-forward interpreter)
            )
      (push (interpreter-code-ptr interpreter) (interpreter-return-stack interpreter))
      )
  ))
(defun interpreter-end-block (interpreter)
  (let* ((tape (interpreter-tape interpreter))
         )
    (if (= 0 (tape-value tape))
        (pop (interpreter-return-stack interpreter))
        (setf (interpreter-code-ptr interpreter)
              (pop (interpreter-return-stack interpreter))))
    ))

(defun interpreter-step (interpreter)
  (let* ((tape (interpreter-tape interpreter))
         )
  (ecase (interpreter-char interpreter)
    (#\+ (tape-increment tape) (interpreter-forward interpreter))
    (#\- (tape-decrement tape) (interpreter-forward interpreter))
    (#\> (tape-forward tape) (interpreter-forward interpreter))
    (#\< (tape-backward tape) (interpreter-forward interpreter))
    (#\. (tape-output tape) (interpreter-forward interpreter))
    (#\, (tape-input tape) (interpreter-forward interpreter))
    (#\[ (interpreter-begin-block interpreter) (interpreter-forward interpreter))
    (#\] (interpreter-end-block interpreter))
    )))
(defun interpreter-should-stop (interpreter)
  (>= (interpreter-code-ptr interpreter)
      (length (interpreter-program interpreter))))

(defparameter *hello* "++++++++[>++++[>++>+++>+++>+<<<<-]>+>+>->>+[<]<-]>>.>---.+++++++..+++.>>.<-.<.+++.------.--------.>>+.>++.")
(defun interpret ()
  (let* ((interpreter (make-interpreter
                       :tape (make-tape :stdin *standard-input*
                                        :stdout *standard-output*)
                       :program *hello*
                       :code-ptr 0
                       :return-stack '())
                      )
         )
    (loop
      :while (not (interpreter-should-stop interpreter))
      :do (interpreter-step interpreter))))

        

(interpret)
